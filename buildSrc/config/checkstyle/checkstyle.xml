<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="com.puppycrawl.tools.checkstyle.Checker">
	<module name="io.spring.javaformat.checkstyle.SpringChecks">
		<property name="excludes" value="com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocPackageCheck, io.spring.javaformat.checkstyle.check.SpringHeaderCheck" />
	</module>
	<module name="com.puppycrawl.tools.checkstyle.checks.header.RegexpHeaderCheck">
		<!-- ltsboot: original Apache 2.0 header + optional line 3 "Modifications Copyright ... the ltsboot contributors." -->
		<property name="headerFile" value="${config_loc}/header.txt"/>
		<property name="fileExtensions" value="java"/>
		<property name="multiLines" value="3"/>
	</module>
</module>